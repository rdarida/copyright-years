{
  "name": "copyright-years",
  "version": "0.1.0",
  "description": "Generate dynamic copyright year ranges (e.g., 2024-2026)",
  "keywords": [
    "copyright",
    "year-range",
    "dynamic-date",
    "footer-utility",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Róbert Darida",
  "homepage": "https://github.com/rdarida/copyright-years#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdarida/copyright-years.git"
  },
  "bugs": {
    "url": "https://github.com/rdarida/copyright-years/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "scripts": {
    "lint": "tsc",
    "prettier": "prettier . --check",
    "pretest": "rimraf ./coverage",
    "test": "jest",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "release:dryrun": "release-it --dry-run",
    "predocs": "rimraf ./docs",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "prettier": "^3.9.4",
    "release-it": "^20.2.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
